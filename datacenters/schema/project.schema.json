{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiankyars.github.io/semiconductor-atlas/data/project.schema.json",
  "title": "Open Data Center Atlas project record",
  "description": "One curated data center build. Every statement cites record-local source ids. See CONTRIBUTING.md for field semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "summary",
    "location",
    "status",
    "status_as_of",
    "status_source_ids",
    "parties",
    "metrics",
    "milestones",
    "sources",
    "last_reviewed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country",
        "lat",
        "lon",
        "precision",
        "source_ids"
      ],
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "admin1": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin2": {
          "type": [
            "string",
            "null"
          ]
        },
        "locality": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "precision": {
          "enum": [
            "site",
            "approximate_site",
            "locality",
            "admin2",
            "admin1"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^s[1-9][0-9]*$"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "status": {
      "enum": [
        "proposed",
        "announced",
        "under_construction",
        "partially_operational",
        "operational",
        "paused",
        "cancelled"
      ]
    },
    "status_as_of": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "status_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^s[1-9][0-9]*$"
      }
    },
    "workloads": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ai_training",
          "ai_inference",
          "ai_unspecified",
          "cloud",
          "colocation",
          "enterprise",
          "hpc",
          "crypto_mining"
        ]
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "source_ids"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "role": {
            "enum": [
              "developer",
              "owner",
              "operator",
              "tenant",
              "investor",
              "builder",
              "power_supplier",
              "utility",
              "hardware_supplier",
              "government"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s[1-9][0-9]*$"
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "value",
          "qualifier",
          "unit",
          "basis",
          "applies_to",
          "as_of",
          "source_ids"
        ],
        "properties": {
          "metric": {
            "enum": [
              "power_capacity",
              "investment",
              "accelerators",
              "floor_area",
              "land_area",
              "buildings",
              "jobs_construction",
              "jobs_permanent"
            ]
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "value_high": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "qualifier": {
            "enum": [
              "exact",
              "approximately",
              "up_to",
              "at_least",
              "more_than",
              "range"
            ]
          },
          "unit": {
            "anyOf": [
              {
                "enum": [
                  "MW",
                  "acres",
                  "count",
                  "hectares",
                  "sq_ft",
                  "sq_m"
                ]
              },
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            ]
          },
          "basis": {
            "enum": [
              "acquired",
              "announced",
              "contracted",
              "incentive_agreement",
              "installed",
              "operational",
              "permitted",
              "planned",
              "reported",
              "under_construction"
            ]
          },
          "power_scope": {
            "enum": [
              "it_load",
              "facility",
              "grid_connection",
              "onsite_generation",
              "unspecified"
            ]
          },
          "applies_to": {
            "enum": [
              "campus",
              "phase"
            ]
          },
          "phase_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "accelerator_model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "as_of": {
            "type": "string",
            "pattern": "^\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?|-Q[1-4]|-H[12])?$"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s[1-9][0-9]*$"
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event",
          "date",
          "kind",
          "source_ids"
        ],
        "properties": {
          "event": {
            "enum": [
              "announced",
              "site_acquired",
              "zoning_approved",
              "permit_approved",
              "construction_started",
              "first_operational",
              "fully_operational",
              "expansion_announced",
              "paused",
              "cancelled",
              "other"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?|-Q[1-4]|-H[12])?$"
          },
          "kind": {
            "enum": [
              "actual",
              "planned"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s[1-9][0-9]*$"
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "power_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "description",
          "source_ids"
        ],
        "properties": {
          "type": {
            "enum": [
              "grid",
              "natural_gas_onsite",
              "nuclear",
              "solar",
              "wind",
              "hydro",
              "geothermal",
              "battery_storage",
              "fuel_cell",
              "diesel_backup",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "title",
          "publisher",
          "published",
          "accessed",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[1-9][0-9]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s/$.?#][^\\s]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "published": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?|-Q[1-4]|-H[12])?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accessed": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "type": {
            "enum": [
              "company",
              "government",
              "regulatory_filing",
              "utility",
              "court",
              "news",
              "trade_press",
              "analyst",
              "other"
            ]
          },
          "archived_url": {
            "type": "string",
            "pattern": "^https?://[^\\s/$.?#][^\\s]*$"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  }
}
